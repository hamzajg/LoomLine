# Local demo environment. Copy to `.env` and override as needed; `docker compose`
# reads `.env` automatically. Nothing here is a production secret.
DB_PASSWORD=loomline

# Identity provider (Keycloak). Demo values only (see
# specs/auth-and-app-shell/SEED-DATA.md) — real deployments override these
# out-of-band and never commit the real client secret.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_ID=loomline-app
OIDC_CLIENT_SECRET=loomline-demo-secret
# The issuer and the browser-facing endpoints use the published address; the API
# reaches Keycloak internally on the container network (set by compose.yaml).
OIDC_ISSUER=http://localhost:8087/realms/loomline
OIDC_AUTHORIZATION_PATH=http://localhost:8087/realms/loomline/protocol/openid-connect/auth
OIDC_END_SESSION_PATH=http://localhost:8087/realms/loomline/protocol/openid-connect/logout
